# NAKAMA — Environment Variables Configuration (.env.example)
# ==============================================================
# Copy this file to .env and populate with your production values.
# NEVER COMMIT .env TO VERSION CONTROL.

# Dedicated NAKAMA Supabase Project (Storage)
SUPABASE_URL="https://nmapnogqfwhouobjejft.supabase.co"
SUPABASE_PROJECT_ID="nmapnogqfwhouobjejft"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
STORAGE_BUCKET_NAME="nakama-project-videos"

# Email Provider Configuration (Resend — https://resend.com)
# 1. Sign up at https://resend.com and generate an API key.
# 2. Add and verify your custom sending domain (e.g. nakama.studio).
# 3. Set CONTACT_FROM_EMAIL to your verified domain (e.g. enquiries@nakama.studio).
# 4. Set CONTACT_TO_EMAIL to your internal team inbox.
RESEND_API_KEY="re_your_resend_api_key_here"
CONTACT_TO_EMAIL="hello@nakama.studio"
CONTACT_FROM_EMAIL="enquiries@nakama.studio"

# Canonical Site URL (for SEO, Open Graph & Sitemap generation)
SITE_URL="https://nakama.studio"

# Server Port (optional, default 3000)
PORT=3000
